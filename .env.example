# NEXORA Studio — placeholder names only. Never commit real values. Set these in Render > Environment (or a local .env that is gitignored).

# --- Website login (REQUIRED, min 12 chars). Without it the website refuses all logins.
NEXORA_ADMIN_PASSWORD=
NEXORA_VIEWER_PASSWORD=            # optional read-only role

# --- Storage (set DATA_DIR to a persistent disk, e.g. /var/data, or projects are lost on restart)
DATA_DIR=
VOICE_PROFILE_DB_PATH=
NEXORA_PERSISTENT_STORAGE=         # optional override: 1 / 0

# --- AI script engine (at least one; the other becomes automatic fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Research sources
TMDB_API_KEY=                      # optional; other sources (Wikipedia, Wikidata, AniList, Kitsu, TVmaze) need no key

# --- Telegram (existing bot + studio notifications / daily reports)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=
GH_TOKEN=
GH_REPO=naykokoko135-pixel/NEXORA-MYANMAR-RECAP

# --- Scheduler wake-up for hosts that sleep (Render Free): call POST /api/internal/tick with header X-NEXORA-Cron-Token
NEXORA_CRON_TOKEN=                 # min 16 chars

# --- Optional: GPU voice host for reference-voice synthesis (must be https)
VOICE_GPU_URL=
NEXORA_TTS_ENGINES=                # optional engine order, e.g. edge,espeak

# --- Optional: official-API publishing (leave empty => publish-ready drafts only)
AUTO_UPLOAD=0
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private
FB_PAGE_ID=
FB_PAGE_TOKEN=

NEXORA_LOG_LEVEL=INFO
