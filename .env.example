# NEXORA — placeholder names only. Never commit real values. Set these in Render > Environment.

# --- Existing bot (already configured on Render)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=           # Render generates it (render.yaml: generateValue)
ERROR_REPORT_TOKEN=
CHATGPT_BRIDGE_API_KEY=
CHATGPT_BRIDGE_CHAT_ID=
NEXORA_CONSOLE_PASSWORD=
TMDB_API_READ_ACCESS_TOKEN=        # TMDB_API_KEY (v3) also works for the studio
GEMINI_API_KEY=
GEMINI_RESEARCH_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- NEXORA Studio (website at /studio/)
NEXORA_ADMIN_PASSWORD=             # REQUIRED, 12+ characters. Without it every login is refused.
NEXORA_VIEWER_PASSWORD=            # optional read-only role
TELEGRAM_CHAT_ID=                  # owner chat for studio notifications and the /studio command (falls back to CHATGPT_BRIDGE_CHAT_ID)
NEXORA_CRON_TOKEN=                 # 16+ chars; lets an external cron call POST /api/internal/tick on a sleeping Render Free instance

# --- Storage: DATA_DIR must be on a persistent disk (paid Render plan) or projects are lost on restart
DATA_DIR=
VOICE_PROFILE_DB_PATH=
NEXORA_PERSISTENT_STORAGE=         # optional override: 1 / 0

# --- Optional
VOICE_GPU_URL=                     # https URL of a GPU voice host (reference-voice synthesis)
VOICE_GPU_TOKEN=
NEXORA_TTS_ENGINES=
AUTO_UPLOAD=0                      # 1 + official API credentials below => upload and verify; otherwise publish-ready drafts
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=private
FB_PAGE_ID=
FB_PAGE_TOKEN=
NEXORA_LOG_LEVEL=INFO
